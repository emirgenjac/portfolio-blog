# Copied into the host/build environment when deploying the frontend.
# Create React App only exposes variables that start with REACT_APP_.

# Backend API base URL (no trailing slash)
REACT_APP_API_URL=http://localhost:8080

# Public site origin used for canonical / Open Graph URLs (no trailing slash)
REACT_APP_SITE_URL=https://portfolio-blog-b33.pages.dev
