# Copy to backend/.env or set these in your IDE / shell (never commit real values).
SPRING_PROFILES_ACTIVE=dev
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/blog
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=your-local-db-password
JWT_SECRET=generate-a-long-random-secret-at-least-32-chars
# JWT_EXPIRATION=86400000

# Cookie flags (optional; defaults come from the active Spring profile)
# APP_COOKIE_SECURE=false
# APP_COOKIE_SAME_SITE=Lax
# APP_COOKIE_MAX_AGE_SECONDS=604800

# CORS — required in prod (exact frontend origin, no trailing slash)
# APP_CORS_ALLOWED_ORIGINS=https://your-frontend.example.com

