# Copy to .env at the repo root for docker compose (never commit .env).

# Postgres (also used by the backend container)
POSTGRES_PASSWORD=postgres

# JWT - use a long random string (32+ chars). Change before any real deploy.
JWT_SECRET=change-me-docker-local-secret-at-least-32-chars

# Baked into the frontend image at build time (browser → host API)
REACT_APP_API_URL=http://localhost:8080
